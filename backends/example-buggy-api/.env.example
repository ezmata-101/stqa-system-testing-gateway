PORT=4000

# Must match the gateway's CONTEXT_SIGNING_SECRET exactly. Never shared with students.
CONTEXT_SIGNING_SECRET=change-me-context-signing-secret

# Admin connection for per-team database routing (path/database replaced per request).
TEAM_DATABASE_ADMIN_URL=postgres://stqa:stqa@localhost:5432/postgres

# This backend's OWN application auth secret — unrelated to the gateway.
APP_JWT_SECRET=insecure-demo-app-secret
