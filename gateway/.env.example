# Public gateway URL (used for building absolute links where needed)
GATEWAY_PUBLIC_URL=http://localhost:3000
PORT=3000

# Control / logging databases (permanent platform components)
CONTROL_DATABASE_URL=postgres://stqa:stqa@localhost:5433/stqa_control
LOGGING_DATABASE_URL=postgres://stqa:stqa@localhost:5433/stqa_logging

# Admin connection used only for CREATE DATABASE / DROP DATABASE / per-team
# pools. Path/database name is replaced per operation; use a superuser or a
# role with CREATEDB + template ownership.
TEAM_DATABASE_ADMIN_URL=postgres://stqa:stqa@localhost:5433/postgres

REDIS_URL=redis://localhost:6380

# Secrets — replace with long random values in real deployments.
CONTEXT_SIGNING_SECRET=change-me-context-signing-secret
CREDENTIAL_HASH_SECRET=dev-credential-hash-secret-change-me
IP_HASH_SECRET=change-me-ip-hash-secret
ADMIN_AUTH_SECRET=change-me-admin-secret
SESSION_SECRET=change-me-session-secret

DEFAULT_REQUEST_TIMEOUT_MS=15000
DEFAULT_MAX_BODY_SIZE=2097152
DEFAULT_RATE_LIMIT=120
DEFAULT_CONTEXT_TOKEN_TTL_SECONDS=60

MAX_LOGGED_BODY_BYTES=8192
MAX_TEAM_DB_POOL_SIZE=2
MAX_GLOBAL_TEAM_DB_CONNECTIONS=40
TEAM_DB_POOL_IDLE_TIMEOUT_MS=300000

BACKEND_NETWORK_ALLOWLIST=
